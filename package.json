{
  "name": "scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev-3123.sh",
    "dev:next": "next dev -p 3123",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "DRIVA_TEST=1 tsx --test src/lib/*.test.ts src/lib/invoices/*.test.ts src/lib/accounting/*.test.ts src/lib/domains/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:assistant": "DRIVA_TEST=1 npx --yes tsx scripts/verify-assistant.ts",
    "test:tax-reduction": "DRIVA_TEST=1 npx --yes tsx scripts/verify-tax-reduction.ts",
    "test:db": "tsx scripts/db-validate.ts",
    "test:adapter": "tsx scripts/adapter-validate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "migrate:local-to-supabase": "tsx scripts/migrate-local-to-supabase.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "puppeteer-core": "^25.9.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
