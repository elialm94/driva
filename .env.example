# Kopiera till .env.local och fyll i. Bara variabelnamn här – aldrig värden.
# Utan Supabase-variablerna körs appen i JSON-läge (.data/db.json) – räcker för
# lokal utveckling och demo. Se README → "Supabase setup".

# ---------------------------------------------------------------- Supabase ---
# Dashboard → Settings → API. Publik (klient + server), skyddas av RLS.
NEXT_PUBLIC_SUPABASE_URL=
# anon/publishable-nyckeln. NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY fungerar också.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dashboard → Connect → Transaction pooler (port 6543) för Vercel/serverless.
# Vercel↔Supabase-integrationen sätter i stället POSTGRES_URL* – accepteras automatiskt.
SUPABASE_DB_URL=
# ENDAST server. Behövs för `npm run db:seed`, migreringsskriptet och för att
# kvittofiler ska sparas i privata bucketen `receipts` (annars inline ≤ 1,5 MB).
SUPABASE_SERVICE_ROLE_KEY=

# Tvinga JSON-läge trots Supabase-variabler (lokal felsökning).
# DRIVA_STORAGE=json

# --------------------------------------------------------------- App-URL:er ---
# Absoluta länkar i utskick (offert-/fakturalänkar). Faller tillbaka på Vercel-URL.
# DRIVA_APP_URL=https://app.exempel.se
# Redirect-bas för Supabase-auth (magic link / återställning).
# NEXT_PUBLIC_SITE_URL=https://app.exempel.se

# ----------------------------------------------------------------- E-post ---
# Live-utskick kräver BÅDE nyckel och avsändare; annars markeras utskick som
# simulerade (aldrig ett tyst låtsas-mejl).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# RESEND_FROM_NAME=Ferva
# Supabase Auth → Send Email-hook (bekräftelse, återställning). Dashboard:
# Auth → Hooks → Send Email → HTTPS https://<prod>/api/auth/send-email
# Klistra in hemligheten här (ofta v1,whsec_…). Utan hooken går mejlen från
# "Supabase Auth". Med hooken krävs också nyckel + avsändare ovan.
# SEND_EMAIL_HOOK_SECRET=
# Supportärenden från plattformsadmin notifieras hit.
# SUPPORT_NOTIFY_EMAIL=

# Inkommande kvitton/leverantörsfakturor. Visad adress: {slug}@in.ferva.se.
# INBOUND_MAIL_MODE=live        # mock | live  (live utan nyckel+hemlighet → 503, inget låtsas-mejl)
# INBOUND_MAIL_DOMAIN=in.ferva.se
# INBOUND_MAIL_WEBHOOK_SECRET=  # HMAC för POST /api/inbox/inbound (tester/manuell POST)
# RESEND_WEBHOOK_SECRET=        # Svix för POST /api/inbox/inbound/resend (inte samma som HMAC)
# RESEND_API_KEY används även för receiving.get / attachments.
#
# Grossistbeställningar (valfri funktion) använder samma Resend-avsändare:
# ordermejl går från RESEND_FROM_EMAIL med visningsnamnet "{Företag} via Ferva"
# och Reply-To = företagets Ferva-inbox ({slug}@INBOUND_MAIL_DOMAIN), så att
# orderbekräftelsen landar i inboxen. Inga extra nycklar krävs.
# DRIVA_WHOLESALER_CATALOG_DIR=   # JSON-/demoläge: var artikelkatalogen lagras (default .data/wholesaler-catalog)
#
# Resend + DNS (in.ferva.se, inte apex ferva.se):
# 1. Resend → Domains → lägg in.ferva.se som eget domain-objekt, slå på Receiving
# 2. MX som Resend visar på host `in` (catch-all: alla {slug}@in.ferva.se)
# 3. Vänta tills Receiving-MX är verified – låtsas inte att Gmail funkar innan dess
# 4. Webhook → https://<prod-host>/api/inbox/inbound/resend, event email.received
# 5. Sätt RESEND_WEBHOOK_SECRET + INBOUND_MAIL_MODE=live i prod
# Plus-adressering (foretaget+FV-1042@in.ferva.se) parsas som uppdrags-
# kandidat efter att tenanten redan lösts från base-sluggen. UI:n påstår
# INTE att det fungerar i produktion förrän det är verifierat mot en
# riktig leverans. Sätt då:
# INBOUND_PLUS_ADDRESSING=verified
#
# 6. Behåll ev. in.driva.se som alias om den redan tar emot

# --------------------------------------------------------------------- AI ---
# Utan nyckel svarar assistenten ärligt "inte konfigurerad" – ingen låtsasmodell.
# AI_PROVIDER=openrouter        # openai-compatible | openrouter | none
# OPENROUTER_API_KEY=
# AI_MODEL_FAST=google/gemini-3.7-flash
# AI_MODEL_SMART=openai/gpt-5.6-terra
# AI_MAX_TOOL_STEPS=6
# Äldre generisk OpenAI-kompatibel väg:
# AI_MODEL= / AI_API_KEY= / AI_BASE_URL=

# --------------------------------------------- Bankkoppling (Tink Open Banking) ---
# AIS – kontoinformation (saldo + transaktioner), inga betalningar. Live-kopplingen
# används BARA för riktiga företag när ALLA tre obligatoriska variabler finns; /demo,
# is_demo-företaget och JSON-läget använder alltid mock-banken (noll HTTP mot Tink).
# Saknas variablerna på ett riktigt företag visas "Bankkoppling är inte konfigurerad".
# Server-only – aldrig NEXT_PUBLIC_TINK_*. Inga Demo Bank-användarnamn här eller i repot.
# TINK_CLIENT_ID=
# TINK_CLIENT_SECRET=
# TINK_REDIRECT_URI=https://app.exempel.se/api/bank/tink/callback   # byte-för-byte samma som i Tink Console
# TINK_MARKET=SE                # default SE
# TINK_ENV=sandbox              # sandbox | production (sandbox → test=true i Tink Link → Demo Bank)

# ------------------------------------------------------------ Google Maps ---
# Places API (New). Utan nyckel: lokala exempeladresser märkta "Demo".
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------- Publik demo (/demo) ---
# DRIVA_DEMO=1                  # tvinga demoläge på/av (default: på i dev/test). Styr även om mock-BankID får signera.
# DEMO_SESSION_HOURS=24         # klampas till 1–72
# DEMO_EMAIL_SINK=              # demons mejl skickas hit med [Demo]-prefix i stället för att simuleras
# DEMO_AI_DAILY_CAP=300
# DRIVA_DEMO_SESSIONS_DIR=      # standard .data/demo-sessions (/tmp på serverless)

# -------------------------------------------------- Egen .se-adress (Hemsida) ---
# Standard är mock – ingen riktig domän köps. Se README → "Egen .se-adress".
# DOMAIN_PROVIDER_MODE=mock     # mock | live
# DOMAIN_REGISTRAR_PROVIDER=openprovider
# DOMAIN_REGISTRAR_MODE=sandbox # sandbox | production
# DOMAIN_REGISTRAR_API_URL=
# DOMAIN_REGISTRAR_USERNAME=
# DOMAIN_REGISTRAR_PASSWORD=
# VERCEL_TOKEN=
# VERCEL_PROJECT_NAME=driva
# VERCEL_TEAM_ID=

# ------------------------------------------------------- Bank / betalfiler ---
# Riktig bankkoppling är avstängd tills en leverantör finns; filerna genereras ändå.
# BANK_PAYMENTS_ENABLED=0
# BANK_PAYMENTS_PROVIDER=

# ------------------------------------------------------- Abonnemang (Stripe) ---
# Stripe Billing: Checkout + Customer Portal + verifierade webhooks. Alla tre
# första krävs, annars säger UI:t "Abonnemangsbetalning är inte konfigurerad"
# och inget abonnemang simuleras för riktiga företag. Server-only – aldrig
# NEXT_PUBLIC_STRIPE_SECRET_*. Test- och live-nycklar får inte blandas.
# STRIPE_SECRET_KEY=            # sk_test_… i utveckling/preview, sk_live_… bara i produktion
# STRIPE_WEBHOOK_SECRET=        # whsec_… från Developers → Webhooks (endpoint /api/stripe/webhook)
# STRIPE_PRICE_ID=              # price_… för Ferva 199 kr/mån ex moms (återkommande, månad, SEK)
# STRIPE_PUBLISHABLE_KEY=       # pk_test_…/pk_live_… (valfri; används inte av Checkout-redirecten)
#
# Stripe-dashboard (test först, sedan live):
# 1. Products → skapa "Ferva" med pris 199 kr/mån, moms exklusive → kopiera price_…
# 2. Developers → Webhooks → Add endpoint https://<prod>/api/stripe/webhook med
#    checkout.session.completed, customer.subscription.created/updated/deleted/
#    paused/resumed/trial_will_end, invoice.paid, invoice.payment_succeeded,
#    invoice.payment_failed, invoice.payment_action_required → kopiera whsec_…
# 3. Settings → Billing → Customer portal: tillåt uppsägning (vid periodens slut),
#    byte av betalmetod, kvitton. Ingen planbyte.
# 4. Lokalt: `stripe listen --forward-to localhost:3123/api/stripe/webhook` och
#    `stripe trigger customer.subscription.updated`.

# ------------------------------------------------------- Plattformsadmin ---
# TOTP-MFA (aal2) krävs för alla admins i Supabase-läget och kan INTE stängas
# av i produktion. 0 ⇒ av endast utanför produktion (staging utan TOTP).
# PLATFORM_ADMIN_REQUIRE_MFA=0

# ------------------------------------------------- Felövervakning (Sentry) ---
# Utan DSN initieras Sentry inte alls (bygget är då oförändrat).
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>     # server + edge
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>  # klient (valfritt)
# SENTRY_ENVIRONMENT=production   # annars VERCEL_ENV/NODE_ENV
# SENTRY_TENANT_SALT=             # valfritt: saltad tenant-hash som tagg; utan salt ingen tenant-tagg
# Endast för source maps i build (CI/Vercel):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# Skrubbning: personnummer, tokens, banktext, dokument-/mejlinnehåll tas bort
# innan sändning (src/lib/observability/scrub.ts). Ingen Session Replay.

# ------------------------------------------------- PWA / offline (spec §9) ---
# Service workern registreras bara i produktion. 1 ⇒ registrera även i dev
# (för att testa installation/offline lokalt). Cachen kan då dölja hot reload.
# NEXT_PUBLIC_PWA_DEV=1
# Mobilskalet (mobile/): vilken driftsatt app WebView:n laddar vid `cap sync`.
# FERVA_APP_URL=https://app.ferva.se

# -------------------------------------------- Restore drill (endast staging) ---
# npm run restore:drill -- --target staging --staging-ref <projektref>
# RESTORE_DRILL_DB_URL=postgres://...@db.<staging-ref>.supabase.co:5432/postgres
# RESTORE_DRILL_STAGING_REF=<staging-ref>
# PRODUCTION_SUPABASE_PROJECT_REF=<prod-ref>   # extra spärr: scriptet vägrar detta värdnamn

# ------------------------------------------------ Juridisk avtalspart (spec §7) ---
# Obligatoriska i produktion. Ingenting hittas på i koden: saknas de visar
# /villkor, /integritet och /bitradesavtal "[avtalspart ej konfigurerad]",
# /api/health blir röd (503) i produktion och Stripe Checkout blockeras.
# LEGAL_ENTITY_NAME=              # bolagets registrerade namn, t.ex. "… AB"
# LEGAL_ENTITY_ORG_NUMBER=        # NNNNNN-NNNN (kontrollsiffran valideras)
# LEGAL_ENTITY_ADDRESS=           # "Gatan 1, 123 45 Ort"
# LEGAL_CONTACT_EMAIL=            # avtals-/villkorsfrågor
# LEGAL_PRIVACY_EMAIL=            # valfri dataskyddskontakt (annars LEGAL_CONTACT_EMAIL)
# Aktiv inlämningsleverantör på /underbitraden (när FILING_API_* är satta):
# FILING_PROVIDER_NAME=
# FILING_PROVIDER_TERMS_URL=

# ------------------------------------------- Inlämning (filing-leverantör) ---
# Utan de två första: manuell guidad inlämning (filen hämtas och lämnas in
# själv, kvittensen registreras av användaren) – ingen låtsasinlämning.
# Live kräver avtal med leverantören, se GO_LIVE_CHECKLIST.md B6.
# FILING_API_BASE_URL=
# FILING_API_TOKEN=
# FILING_ENV=test               # test | production (standard test)

# ------------------------------------------------------------ Vercel Cron ---
# /api/cron/reminders (vercel.json, 07:00) kräver Bearer CRON_SECRET; Vercel
# skickar den automatiskt när variabeln finns i projektet. Utan den svarar
# endpointen 401 och /api/health varnar cron_never_ran.
# CRON_SECRET=

# ---------------------------------------------------------------- Drift ---
# DRIVA_PERF=1                  # per-request-telemetri i serverloggen (av i prod)
# DRIVA_SNAPSHOT_CACHE=0        # stäng av tenantcachen i minnet
